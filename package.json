{
  "name": "flashread",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm run build -w @flashread/core",
    "build:desktop": "npm run build -w @flashread/desktop",
    "build": "npm run build:core && npm run build:desktop",
    "dev": "npm run build && npm run start -w @flashread/desktop",
    "start": "npm run start -w @flashread/desktop"
  }
}

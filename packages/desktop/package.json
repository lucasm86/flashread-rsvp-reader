{
  "name": "@flashread/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lector RSVP para Windows",
  "author": "lucasm86",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "release:win": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@flashread/core": "0.1.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "epub2": "^3.0.2",
    "mammoth": "^1.8.0",
    "markitdown-ts": "^0.0.10",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.flashread.app",
    "productName": "FlashRead",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "lucasm86",
      "repo": "flashread-rsvp-reader"
    }
  }
}
